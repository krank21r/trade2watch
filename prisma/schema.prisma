generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── AI Signal Engine (TradingAgents adaptation) ────────────────────────────

model SignalRun {
  id          String    @id @default(cuid())
  symbol      String // BTC, ETH, AAPL, TSLA...
  market      String // 'crypto' | 'stock'
  displayName String? // "Bitcoin", "Apple Inc."
  status      String    @default("running") // running | completed | failed
  stage       String    @default("queued") // queued | data | analysts | debate | plan | risk | decision | done
  progress    Int       @default(0) // 0-100
  error       String?

  // market snapshot at run time
  priceAtRun Float?
  change24h  Float?
  regime     String? // TRENDING_UP | TRENDING_DOWN | RANGING
  timeframe  String? // "4h" (crypto) | "1d" (stocks)

  // final signal (the Trade2watch-style setup)
  direction    String? // LONG | SHORT | NEUTRAL
  confidence   Int? // 0-100
  entryLow     Float?
  entryHigh    Float?
  stop         Float?
  target1      Float?
  target2      Float?
  runner       Float?
  riskReward   String? // "1 : 2.4 at T1 · 1 : 4.0 at T2"
  invalidation String?
  planNote     String? // trader's one-line strategy note

  // full agent artifacts (analyst reports, debates, risk, verdict)
  artifacts Json?

  // outcome tracking
  outcome          String?   // OPEN | TARGET1_HIT | TARGET2_HIT | STOP_HIT | INVALIDATED
  outcomeCheckedAt DateTime?
  outcomePrice     Float?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([symbol, createdAt])
  @@index([status])
  @@index([createdAt])
}

// ─── SMC engine (Smart Money Concepts) signal log ───────────────────────────

model SmcSignal {
  id        String @id @default(cuid())
  symbol    String
  direction String // LONG | SHORT
  setup     String @default("SMC_ORDER_BLOCK")
  quality   String // A+ | A | B | C
  score     Int
  mode      String @default("STRICT")

  entryLow  Float
  entryHigh Float
  entryMid  Float
  stopLoss  Float
  tp1       Float
  tp2       Float
  tp3       Float
  rr1       Float
  rr2       Float
  rr3       Float

  obTime  Float // ms epoch — Float: SQLite REAL is exact for epoch-ms (< 2^53) // OB candle open time (ms) — part of the natural dedupe key
  obLow   Float
  obHigh  Float
  reasons Json?

  status    String @default("ACTIVE") // ACTIVE | TP1_HIT | TP2_HIT | TP3_HIT | SL_HIT | EXPIRED | INVALIDATED
  result    String? // WIN | LOSS | BREAKEVEN | EXPIRED
  rMultiple Float?

  tp1At    Float?
  tp2At    Float?
  tp3At    Float?
  slAt     Float?
  closedAt Float?

  createdAt Float
  updatedAt Float

  @@unique([symbol, obTime, direction])
  @@index([symbol, status])
  @@index([symbol, createdAt])
}
