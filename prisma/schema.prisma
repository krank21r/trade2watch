generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── AI Signal Engine (TradingAgents adaptation) ────────────────────────────

model SignalRun {
  id          String    @id @default(cuid())
  symbol      String // BTC, ETH, AAPL, TSLA...
  market      String // 'crypto' | 'stock'
  displayName String? // "Bitcoin", "Apple Inc."
  source      String? // 'auto' (scheduled desk) | 'manual' (user click)
  status      String    @default("running") // running | completed | failed
  stage       String    @default("queued") // queued | data | analysts | debate | plan | risk | decision | done
  progress    Int       @default(0) // 0-100
  error       String?

  // market snapshot at run time
  priceAtRun Float?
  change24h  Float?
  regime     String? // TRENDING_UP | TRENDING_DOWN | RANGING
  timeframe  String? // "4h" (crypto) | "1d" (stocks)

  // final signal (the Trade2watch-style setup)
  direction    String? // LONG | SHORT | NEUTRAL
  confidence   Int? // 0-100
  entryLow     Float?
  entryHigh    Float?
  stop         Float?
  target1      Float?
  target2      Float?
  runner       Float?
  riskReward   String? // "1 : 2.4 at T1 · 1 : 4.0 at T2"
  invalidation String?
  planNote     String? // trader's one-line strategy note

  // full agent artifacts (analyst reports, debates, risk, verdict)
  artifacts Json?

  // outcome tracking
  outcome          String?   // OPEN | TARGET1_HIT | TARGET2_HIT | STOP_HIT | INVALIDATED
  outcomeCheckedAt DateTime?
  outcomePrice     Float?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([symbol, createdAt])
  @@index([status])
  @@index([createdAt])
}

// ─── Trader Desk ─────────────────────────────────────────────────────────────
// The desk is now: screener signals (entry/stop/targets) → "I took this trade"
// → frozen-plan tracking. Taken trades live in UserTradeStore (below) — the
// same journal the Trade Setups tab uses — so no separate pipeline models.

// ─── Per-user personal trade journal (server-synced across devices) ─────────
// "I took this trade" entries live here keyed by the signed-in user id, so the
// same account sees identical open/closed trades on every device. The whole
// (trimmed ≤40) list is stored as JSON — the client already treats the journal
// as an atomic full-list snapshot, so a blob row mirrors its semantics 1:1.
model UserTradeStore {
  userId    String @id // auth user id (kranthi / analyst1 / analyst2)
  trades    String // JSON array of MyTrade
  updatedAt Float // ms epoch — last writer wins across devices

  @@index([updatedAt])
}
